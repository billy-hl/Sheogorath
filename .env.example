# .env holds credentials only.
#
# Guild, channel and role IDs live in config/guilds.json — one entry per Discord
# server the bot serves, with a `features` list controlling what runs where.
# Copy that file's placeholder entry to onboard a second guild.

# Discord Bot Configuration
DISCORD_TOKEN=your_discord_bot_token_here
CLIENT_ID=your_bot_client_id
# Primary guild. Seeds config/guilds.json on first run, attributes
# pre-multi-guild state during migration, and is the control API's default.
GUILD_ID=your_server_guild_id
# Bot owner. Always counts as admin, in every guild.
ADMIN_USER_ID=your_discord_user_id

# AI Configuration
GROK_API_KEY=your_grok_api_key_from_x.ai
KREA_API_KEY=your_krea_api_key_from_krea.ai
CLIENT_NAME=Sheogorath
CLIENT_INSTRUCTIONS=You ARE Sheogorath, the Daedric Prince of Madness from The Elder Scrolls. This is not roleplay - you ARE this character....
CLIENT_MODEL=grok-code-fast-1

# Not per-guild: one operator channel receives errors from every guild.
ERROR_CHANNEL_ID=optional_error_notification_channel_id

# Ollama — backs the text-image moderation filter. Must be reachable from
# whichever host the bot runs on.
OLLAMA_URL=http://localhost:11434
OLLAMA_MOD_MODEL=llama3.2

# --- Local voice (optional) ---------------------------------------------------
# Lets a model on Leviathan's GPU write his chat replies instead of Grok, with
# Grok taking any turn the local model should not (see src/ai/voice.js). Both
# must be set and pulled in Ollama, or every reply stays on Grok exactly as
# before. Images, memory extraction and #help are unaffected either way.
# A guild opts out with "localVoice": false under `ai` in config/guilds.json.
LOCAL_VOICE_MODEL=
# e.g. hf.co/bartowski/MN-12B-Mag-Mell-R1-GGUF:Q4_K_M
LOCAL_GUARD_MODEL=
# e.g. llama-guard3:1b — runs on the CPU, screens requests and replies
# Llama Guard categories that send a turn to Grok. Default: S1,S2,S3,S4,S7,S9,S10,S11
# LOCAL_GUARD_BLOCK=
# Same for his replies; defaults to the list above without S1 (violent crimes)
# LOCAL_GUARD_BLOCK_REPLY=
# How long the voice stays loaded on the GPU between replies. Default: 1h
# LOCAL_VOICE_KEEP_ALIVE=1h
# Give up on the local voice and ask Grok after this long. Default: 45000
# LOCAL_VOICE_TIMEOUT_MS=45000

# Project Zomboid
# Host, port and log paths are per-guild and live under `zomboid` in
# config/guilds.json.
#
# Leave this EMPTY on the Leviathan deployment. RCON goes through
# /usr/local/bin/pzrcon.py (see zomboid.rcon.client), which reads RCONPassword
# straight from the server ini — the only copy guaranteed to match what the
# running server is using, since a rotated password staged in the game server's
# .env does not apply until the container restarts. Set this only if you ever
# replace that helper with an in-process RCON client.
ZOMBOID_RCON_PASSWORD=

# Control API (companion web app)
# Admin credential — moderation and server changes. Minimum 16 chars or the API
# refuses to start. Generate with: openssl rand -hex 32
CONTROL_API_TOKEN=
# Guest credential shared with friends — full music control, no moderation.
# Minimum 8 chars. Pick something memorable; it gets shared verbally.
CONTROL_GUEST_PASSWORD=
CONTROL_API_PORT=3005
# Bind address. Set to the Tailscale IP so the API is reachable only over the
# tailnet — never 0.0.0.0, which would expose it to the whole LAN.
CONTROL_API_HOST=127.0.0.1
# Which guild the companion app drives. Defaults to GUILD_ID.
CONTROL_API_GUILD_ID=

# Optional: Logging
LOG_LEVEL=info

# Optional: yt-dlp binary location
# youtube-dl-exec ships its own yt-dlp under node_modules, which is what /play's
# search, autoplay and playlist expansion use — while playback spawns whatever
# `yt-dlp` is on PATH. Two binaries drifting apart means half the music stack can
# rot while the other half looks fine. Point the package at the system install so
# there is one binary and `pip install -U yt-dlp` updates everything.
# YouTube breaks older yt-dlp builds regularly (symptom: every track resolves a
# title, then dies instantly on "HTTP Error 403: Forbidden"), so keep it current.
YOUTUBE_DL_DIR=/usr/local/bin
# Stops the package postinstall from trying to overwrite the system binary.
YOUTUBE_DL_SKIP_DOWNLOAD=true

# --- AI spend ceiling ---------------------------------------------------------
# Hard monthly limit in USD across every guild on this API key. Spend is metered
# from xAI's own `cost_in_usd_ticks` on each response — the amount actually
# billed, after prompt-caching discounts — so this is measured, not estimated.
# Staff are warned in the log channel at 50%, 80% and 95%; at 100% Sheogorath
# stops answering until the month turns or this number goes up. Defaults to 20.
AI_MONTHLY_BUDGET_USD=20

# --- Twitch live announcements ------------------------------------------------
# One app's credentials, shared by every guild; who gets announced and where is
# per-guild, under `twitch` in config/guilds.json.
#
# Create an application at https://dev.twitch.tv/console/apps — any name, OAuth
# redirect http://localhost, category "Chat Bot" — then copy the Client ID and
# generate a Client Secret. Nothing is authorised against a Twitch account: the
# watcher uses a client_credentials app token and only reads which public
# channels are live. Leave these unset and live announcements stay off.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
